# Copiar a .env y ajustar. .env esta en .gitignore.

# --- Base de datos ---
# OJO: tu PostgreSQL 18 local escucha en 5431, no en el 5432 por defecto.
DATABASE_URL=postgresql+psycopg://ingles:ingles@localhost:5431/ingles

# --- Motor de pronunciacion ---
# mock  -> sin dependencias ni llaves, scores sinteticos. Sirve para probar el circuito completo.
# azure -> Azure Speech Pronunciation Assessment (requiere llave). Calidad de produccion.
# local -> wav2vec2 fonemico offline (requiere requirements-local.txt, ~2 GB de modelo).
PRONUNCIATION_ENGINE=mock

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Modelo local (solo si PRONUNCIATION_ENGINE=local)
LOCAL_W2V2_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft

# --- Sintesis de voz (escuchar la pronunciacion correcta) ---
# Usa la MISMA llave de Azure que la evaluacion. El tier F0 incluye
# 0.5 M de caracteres/mes de voz neuronal; una palabra son ~6.
TTS_PROVIDER=azure
AZURE_TTS_VOICE=en-US-JennyNeural

# --- Capa LLM: traduccion paralela ES/EN y glosas en contexto ---
# none   -> el lector muestra solo ingles. Funciona sin llave.
# claude -> API de Anthropic. Mejor calidad de interpretacion, cuesta por token.
# ollama -> modelo local. Gratis, privado, mas lento.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Solo si LLM_PROVIDER=ollama. El modelo hay que descargarlo antes:
#   ollama pull <modelo>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Ollama usa 4096 por defecto y RECORTA EN SILENCIO lo que no cabe: con un
# lote de oraciones mas su contexto de parrafo, eso se desborda y el sintoma
# es «faltan traducciones» sin ningun error.
OLLAMA_NUM_CTX=8192
# NO DEFINAS OLLAMA_THINK. Medido contra Ollama 0.30.7 con qwen3.6: mandar
# `think: false` desactiva la gramatica que obliga al esquema JSON y el modelo
# responde prosa libre, lo que rompe la alineacion bilingue. Parece un ajuste
# de rendimiento inofensivo y no lo es. Sin la variable, no se manda.
#
# Las glosas son otra historia y por eso tienen su propio ajuste. Con qwen3:8b,
# razonando tardan entre 5 y 14 segundos (1500-2100 caracteres de pensamiento
# para definir UNA palabra); con `false` tardan 0.8s, el esquema se respeta y
# la definicion sale igual de buena. Tocas una palabra y esperas mirando, asi
# que la latencia aqui es la funcion. Si tu modelo de glosas rompe el esquema
# con esto, hay reintento automatico sin el parametro; pon None para apagarlo.
OLLAMA_GLOSS_THINK=false
# Ollama libera el modelo tras 5 minutos sin uso, y recargarlo costaba 3.6s en
# la siguiente palabra que tocaras.
OLLAMA_KEEP_ALIVE=30m
# Oraciones por peticion al traducir. Mas grande = menos llamadas y mejor
# aprovechamiento del cache, pero mas riesgo de truncar la respuesta.
TRANSLATION_BATCH_SIZE=25

# --- Almacenamiento ---
# Las grabaciones se guardan aqui. Ver README: conservarlas permite re-evaluar
# todo el historial cuando cambies de motor.
ASSETS_DIR=./data/assets

# --- Servidor ---
CORS_ORIGINS=http://localhost:5173
